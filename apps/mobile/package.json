{
  "name": "@hooked/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "ota:check": "node scripts/ota-check.mjs",
    "ota:production": "node scripts/ota-check.mjs && npx --yes eas-cli@24 update --branch production --environment production",
    "ota:staging": "node scripts/ota-check.mjs --build-profile=staging && npx --yes eas-cli@24 update --branch staging --environment production",
    "ota:preview": "npx --yes eas-cli@24 update --branch preview --environment preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/game/*.test.js"
  },
  "dependencies": {
    "@hooked/engine": "*",
    "@hooked/levels": "*",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  }
}
