PORT=4000
NODE_ENV=development

# Mongo (local for dev; the Atlas mongodb+srv:// string in Heroku's Config Vars)
MONGODB_URI=mongodb://127.0.0.1:27017/hooked

# CORS — comma-separated origins allowed to call the API from a browser (apps/admin's Vite dev
# server, reserved on 5175 for phase 7; the playground on 5174 never calls the API).
# Unset = allow any origin, which is fine while the only clients are the phone app and curl.
CLIENT_ORIGIN=http://localhost:5175

# --- Phase 7 (DESIGN.md §11 Backend). Leave unset until then. ---
# JWT_SECRET=replace-with-long-random-string
# JWT_EXPIRES_IN=30d
# ADMIN_KEY=replace-with-long-random-string      # guards /api/admin/* and the admin page
# REVENUECAT_WEBHOOK_SECRET=                     # Authorization header RevenueCat sends
# APPLE_BUNDLE_ID=                               # Sign in with Apple audience
# GOOGLE_CLIENT_IDS=                             # comma-separated, iOS + Android + web
